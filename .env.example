# Copy to .env (gitignored). Used by `pnpm photos:publish` to upload to R2.
#
# Account ID: Cloudflare dashboard -> R2 Object Storage -> right-hand column.
R2_ACCOUNT_ID=
# R2 API token with "Object Read & Write" scoped to the photos bucket:
# R2 Object Storage -> Manage R2 API Tokens -> Create API token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional, defaults to personal-site-photos (must match wrangler.toml).
# R2_BUCKET=personal-site-photos
