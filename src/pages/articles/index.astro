---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Articles" description="Articles by Martin Ryberg Laude">
  <ul class="flex flex-col gap-8 px-2 py-20 md:px-6">
    {
      posts.map((post) => (
        <li>
          <a href={`/articles/${post.id}/`} class="group">
            <h4 class="font-sans text-base group-hover:underline dark:text-white">
              {post.data.title}
            </h4>
            <p class="text-base text-stone-400 dark:text-stone-400">
              {post.data.description}
            </p>
            <p class="mt-1">
              <FormattedDate date={post.data.pubDate} />
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
